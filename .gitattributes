# Store source files with consistent Unix line endings across platforms.
* text=auto
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Keep Windows command files native when they are intentionally committed.
*.bat text eol=crlf
*.ps1 text eol=crlf
